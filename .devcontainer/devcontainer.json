{
    "name": "railbound devcontainer",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "shutdownAction": "stopCompose",
    "postCreateCommand": "sudo chown -R $(id -u):$(id -g) /workspace /home/vscode/.codex && sudo chmod -R u+rwX /workspace /home/vscode/.codex",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "mhutchie.git-graph"
            ]
        }
    },
    "forwardPorts": [
        1455
    ],
    "portsAttributes": {
        "1455": {
            "label": "Codex OAuth",
            "onAutoForward": "silent",
            "requireLocalPort": true
        }
    }
}
