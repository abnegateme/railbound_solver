{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Railbound: Run all tests",
            "type": "shell",
            "command": "pytest",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$pytest"
        }
    ]
}
